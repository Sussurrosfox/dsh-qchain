             "effective_concurrency", "diagnostic_codes"],
  "cases": [
    {
      "name": "v2_template_default_full_scope",
      "why": "PARCFG-01：模板默认（不预填 profile）+ dispatch_contract_version=2 + run_scope=full → fast/4",
      "config": {
        "dispatch_contract_version": 2,
        "agent_dispatch": { "max_concurrency": 0, "allow_unattested": false },
        "agent_max_concurrency": 0
      },
      "run_scope": "full",
      "execution_profile": "faithful_fast",
      "expect": {
        "dispatch_contract_version": 2, "profile": "fast",
        "profile_source": "run_scope:full", "configured_concurrency": 0,
        "concurrency_source": "auto", "concurrency_limit": 4,
        "executor_kind": "host_subagent", "worker_max_concurrency": null,
        "capability_verified": false, "effective_concurrency": 4,
        "diagnostic_codes": []
      }
    },
