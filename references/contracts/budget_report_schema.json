{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BudgetReportContract",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "tool_version",
    "category",
    "problems",
    "warnings",
    "estimates_ref"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [2, 3] },
    "tool": { "type": "string", "enum": ["check_budget", "check_budget.py"] },
    "tool_version": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["ok", "coverage", "section", "config", "artifact"]
    },
    "problems": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "estimates_ref": { "type": ["string", "null"] }
  }
}
